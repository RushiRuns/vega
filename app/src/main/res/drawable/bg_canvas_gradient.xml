<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Deep Charcoal Color #111111 -->
    <item>
        <color android:color="#111111" />
    </item>

    <!-- Top-Left Radial Graphite Highlight (#1F1F22 to transparent) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="0.0"
                android:centerY="0.0"
                android:startColor="#1F1F22"
                android:endColor="#001F1F22" />
        </shape>
    </item>

    <!-- Bottom-Right Radial Shadow (#0A0A0B to transparent) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="1.0"
                android:centerY="1.0"
                android:startColor="#0A0A0B"
                android:endColor="#000A0A0B" />
        </shape>
    </item>
</layer-list>
