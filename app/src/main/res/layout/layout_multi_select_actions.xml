<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_multi_select_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    app:cardCornerRadius="28dp"
    app:cardElevation="32dp"
    app:cardBackgroundColor="@color/vega_surface"
    app:strokeWidth="0dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:paddingHorizontal="16dp">

        <!-- Hidden stubs for ViewBinding compatibility in other fragments -->
        <ImageButton
            android:id="@+id/btn_clear_selection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Due Date Action -->
            <LinearLayout
                android:id="@+id/btn_action_due_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="#25262A"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:clickable="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_action_calendar"
                        app:tint="#A0A2AA" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="DUE DATE"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="#8E9096"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Priority Action -->
            <LinearLayout
                android:id="@+id/btn_action_priority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="#25262A"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:clickable="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_action_flag"
                        app:tint="#A0A2AA" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PRIORITY"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="#8E9096"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- State Action -->
            <LinearLayout
                android:id="@+id/btn_action_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="#25262A"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:clickable="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_action_state"
                        app:tint="#A0A2AA" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="STATE"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="#8E9096"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Recurrence Action -->
            <LinearLayout
                android:id="@+id/btn_action_recurrence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="#25262A"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:clickable="false">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_action_repeat"
                        app:tint="#A0A2AA" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="REPEAT"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="#8E9096"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
