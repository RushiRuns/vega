<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_multi_select_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_md"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/vega_surface_overlay"
    app:strokeWidth="0dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm">

            <ImageButton
                android:id="@+id/btn_clear_selection"
                android:layout_width="@dimen/icon_tap_target"
                android:layout_height="@dimen/icon_tap_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/vega_on_surface_muted"
                android:contentDescription="Clear Selection" />

            <TextView
                android:id="@+id/tv_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.Vega.Title"
                android:text="0 selected"
                android:textColor="@color/vega_on_background" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Due Date Action -->
            <LinearLayout
                android:id="@+id/btn_action_due_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="@dimen/spacing_xs">
                
                <FrameLayout
                    android:layout_width="@dimen/bulk_select_tap_target"
                    android:layout_height="@dimen/bulk_select_tap_target"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="@color/vega_on_surface" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Due Date"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="@color/vega_on_surface_muted" />
            </LinearLayout>

            <!-- Priority Action -->
            <LinearLayout
                android:id="@+id/btn_action_priority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="@dimen/spacing_xs">
                
                <FrameLayout
                    android:layout_width="@dimen/bulk_select_tap_target"
                    android:layout_height="@dimen/bulk_select_tap_target"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="@color/vega_on_surface" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Priority"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="@color/vega_on_surface_muted" />
            </LinearLayout>

            <!-- State Action -->
            <LinearLayout
                android:id="@+id/btn_action_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="@dimen/spacing_xs">

                <FrameLayout
                    android:layout_width="@dimen/bulk_select_tap_target"
                    android:layout_height="@dimen/bulk_select_tap_target"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_directions"
                        app:tint="@color/vega_on_surface" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="State"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="@color/vega_on_surface_muted" />
            </LinearLayout>

            <!-- Recurrence Action -->
            <LinearLayout
                android:id="@+id/btn_action_recurrence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="@dimen/spacing_xs">

                <FrameLayout
                    android:layout_width="@dimen/bulk_select_tap_target"
                    android:layout_height="@dimen/bulk_select_tap_target"
                    android:background="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_repeat"
                        app:tint="@color/vega_recurring_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repeat"
                    android:textAppearance="@style/TextAppearance.Vega.Micro"
                    android:textColor="@color/vega_on_surface_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
