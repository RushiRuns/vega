<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vega_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Day Card Block -->
            <FrameLayout
                android:id="@+id/card_hero_day"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_card_height"
                android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_hero_card_gradient"
                android:padding="@dimen/hero_card_padding">

                <!-- Top Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Left Translucent Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_hero_badge_pill"
                        android:paddingHorizontal="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_action_calendar"
                            app:tint="@android:color/white" />

                        <TextView
                            android:id="@+id/tv_hero_left_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Today"
                            android:textAppearance="@style/TextAppearance.Vega.Label"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <!-- Right Translucent Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_hero_badge_pill"
                        android:paddingHorizontal="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_meta_spark"
                            app:tint="@android:color/white" />

                        <TextView
                            android:id="@+id/tv_hero_right_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Focus"
                            android:textAppearance="@style/TextAppearance.Vega.Label"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Content Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <!-- Bottom Left: Day Name & Week Subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Vega.Display"
                            android:textColor="@android:color/white"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="Wednesday" />

                        <TextView
                            android:id="@+id/tv_week_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Week 38"
                            android:textAppearance="@style/TextAppearance.Vega.Body"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Bottom Right: Date Full -->
                    <TextView
                        android:id="@+id/tv_date_full"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.Vega.TitleLarge"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Sept 20" />
                </LinearLayout>
            </FrameLayout>

            <!-- 7-Day Date Strip Container -->
            <LinearLayout
                android:id="@+id/layout_date_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Mon -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18"
                        android:textAppearance="@style/TextAppearance.Vega.Title"
                        android:textColor="@color/vega_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="MON"
                        android:textAppearance="@style/TextAppearance.Vega.Micro"
                        android:textColor="@color/vega_on_surface_muted" />
                </LinearLayout>

                <!-- Tue -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19"
                        android:textAppearance="@style/TextAppearance.Vega.Title"
                        android:textColor="@color/vega_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="TUE"
                        android:textAppearance="@style/TextAppearance.Vega.Micro"
                        android:textColor="@color/vega_on_surface_muted" />
                </LinearLayout>

                <!-- Wed (Selected Pill) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hero_badge_pill"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textAppearance="@style/TextAppearance.Vega.Title"
                        android:textColor="@color/vega_accent_blue"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="WED"
                        android:textAppearance="@style/TextAppearance.Vega.Micro"
                        android:textColor="@color/vega_accent_red"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Thu -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21"
                        android:textAppearance="@style/TextAppearance.Vega.Title"
                        android:textColor="@color/vega_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="THU"
                        android:textAppearance="@style/TextAppearance.Vega.Micro"
                        android:textColor="@color/vega_on_surface_muted" />
                </LinearLayout>

                <!-- Fri -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22"
                        android:textAppearance="@style/TextAppearance.Vega.Title"
                        android:textColor="@color/vega_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="FRI"
                        android:textAppearance="@style/TextAppearance.Vega.Micro"
                        android:textColor="@color/vega_on_surface_muted" />
                </LinearLayout>

                <!-- Sat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="23"
                        android:textAppearance="@style/TextAppearance.Vega.Title"
                        android:textColor="@color/vega_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="SAT"
                        android:textAppearance="@style/TextAppearance.Vega.Micro"
                        android:textColor="@color/vega_on_surface_muted" />
                </LinearLayout>

                <!-- Sun -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textAppearance="@style/TextAppearance.Vega.Title"
                        android:textColor="@color/vega_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="SUN"
                        android:textAppearance="@style/TextAppearance.Vega.Micro"
                        android:textColor="@color/vega_on_surface_muted" />
                </LinearLayout>

            </LinearLayout>

            <!-- Summary Greeting Block -->
            <TextView
                android:id="@+id/tv_summary_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_margin_horizontal"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                android:textAppearance="@style/TextAppearance.Vega.HeadlineSmall"
                android:textSize="20sp"
                android:textColor="@color/vega_on_background"
                android:lineSpacingMultiplier="1.2"
                android:text="Good morning, Alexey. You have 3 meetings, 2 tasks and 1 habit today." />

            <!-- Tasks Section Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tasks_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Task List RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_today_tasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingVertical="0dp"
                        tools:listitem="@layout/item_task_today" />

                    <!-- Empty State View -->
                    <LinearLayout
                        android:id="@+id/layout_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@android:drawable/ic_menu_today"
                            app:tint="@color/vega_on_surface_muted" />

                        <TextView
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="@string/empty_today"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textColor="@color/vega_on_surface_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
