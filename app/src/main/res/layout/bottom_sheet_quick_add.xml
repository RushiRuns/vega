<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/vega_surface_overlay">

    <!-- Handle indicator for bottom sheet -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/spacing_md"
        android:src="@drawable/bg_drag_handle" />

    <!-- Title for the Quick Add sheet -->
    <TextView
        android:id="@+id/text_quick_add_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:text="@string/title_quick_add"
        android:textAppearance="@style/TextAppearance.Vega.Title"
        android:textColor="@color/vega_on_background" />

    <!-- Text input for task capture -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_task_input"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        app:boxStrokeColor="@color/vega_primary"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_task_input"
            android:inputType="textCapSentences"
            android:textColor="@color/vega_on_background"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Preview Label -->
    <TextView
        android:id="@+id/text_preview_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:text="@string/label_parsing_preview"
        android:textAppearance="@style/TextAppearance.Vega.Caption"
        android:textColor="@color/vega_on_surface"
        android:visibility="gone" />

    <!-- Horizontal Chip Container for real-time parser preview -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/group_chips_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:singleLine="true">

        <!-- Date Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_date_preview"
            style="@style/Widget.MaterialComponents.Chip.Entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tomorrow"
            android:visibility="gone"
            app:chipIcon="@android:drawable/ic_menu_my_calendar"
            app:chipIconTint="@color/vega_on_surface"
            app:closeIconVisible="true" />

        <!-- Priority Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_priority_preview"
            style="@style/Widget.MaterialComponents.Chip.Entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High"
            android:visibility="gone"
            app:chipIcon="@android:drawable/ic_dialog_alert"
            app:closeIconVisible="true" />

        <!-- Recurrence Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_recurrence_preview"
            style="@style/Widget.MaterialComponents.Chip.Entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily"
            android:visibility="gone"
            app:chipIcon="@android:drawable/ic_popup_sync"
            app:chipIconTint="@color/vega_recurring_accent"
            app:closeIconVisible="true" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Tags Selection Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_xs">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tags"
            android:textAppearance="@style/TextAppearance.Vega.Label"
            android:textColor="@color/vega_on_surface" />

        <TextView
            android:id="@+id/btn_manage_tags_quick_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Manage Tags"
            android:textAppearance="@style/TextAppearance.Vega.Caption"
            android:textColor="@color/vega_primary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_quick_add_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        app:singleSelection="false" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:textColor="@color/vega_primary"
            android:text="@string/button_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_another"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:textColor="@color/vega_primary"
            android:text="@string/button_add_another" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="@color/vega_primary"
            android:textColor="#121218"
            android:text="@string/button_add" />
    </LinearLayout>
</LinearLayout>
