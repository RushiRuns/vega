<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dark_gradient"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/bg_drag_handle" />

    <!-- Header Row: Manage Tags + + NEW TAG -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_title_manage_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Manage Tags"
            android:textAppearance="@style/TextAppearance.Vega.Title"
            android:textColor="@color/vega_on_background"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_add_new_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:text="+ NEW TAG"
            android:textColor="#1AD1B9"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Quick Add Tag Input Row (Image 3) -->
    <LinearLayout
        android:id="@+id/layout_quick_add"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_setting_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <EditText
            android:id="@+id/et_quick_tag_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Tag name..."
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E9096"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_quick_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_save"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Add"
            android:textColor="#121218"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tags RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_manage_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:maxHeight="320dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No tags created yet."
        android:textColor="#8E9096"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Done Bottom Button (Image 3) -->
    <TextView
        android:id="@+id/btn_done_manage_tags"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_filter_pill_inactive"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Done"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
