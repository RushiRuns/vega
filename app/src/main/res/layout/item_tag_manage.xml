<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_sm"
    android:paddingHorizontal="@dimen/spacing_xs">

    <!-- Color Dot -->
    <View
        android:id="@+id/view_tag_color_dot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/bg_priority_pill" />

    <!-- Tag Name -->
    <TextView
        android:id="@+id/tv_tag_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Vega.Body"
        android:textColor="@color/vega_on_background" />

    <!-- Action Edit Button -->
    <ImageButton
        android:id="@+id/btn_edit_tag"
        android:layout_width="@dimen/icon_tap_target"
        android:layout_height="@dimen/icon_tap_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit Tag"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="@color/vega_on_surface" />

    <!-- Action Delete Button -->
    <ImageButton
        android:id="@+id/btn_delete_tag"
        android:layout_width="@dimen/icon_tap_target"
        android:layout_height="@dimen/icon_tap_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Tag"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/vega_priority_high" />

</LinearLayout>
