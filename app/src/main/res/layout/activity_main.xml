<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient">

    <!-- Navigation Host Fragment (main content) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Floating Bottom Bar & Action Button Container -->
    <LinearLayout
        android:id="@+id/layout_floating_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/floating_nav_bar_bottom_margin"
        android:paddingHorizontal="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Floating Pill Toolbar -->
        <LinearLayout
            android:id="@+id/floating_nav_bar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/floating_nav_bar_height"
            android:background="@drawable/bg_floating_nav_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <!-- Today Tab Button -->
            <ImageButton
                android:id="@+id/nav_btn_today"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/title_today"
                android:src="@drawable/ic_nav_today"
                app:tint="@color/vega_nav_icon_active" />

            <!-- Upcoming Tab Button -->
            <ImageButton
                android:id="@+id/nav_btn_upcoming"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/title_upcoming"
                android:src="@drawable/ic_nav_upcoming"
                app:tint="@color/vega_nav_icon_inactive" />

            <!-- Inbox Tab Button -->
            <ImageButton
                android:id="@+id/nav_btn_inbox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/title_inbox"
                android:src="@drawable/ic_nav_inbox"
                app:tint="@color/vega_nav_icon_inactive" />

            <!-- Settings Tab Button -->
            <ImageButton
                android:id="@+id/nav_btn_settings"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/title_settings"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/vega_nav_icon_inactive" />

        </LinearLayout>

        <Space
            android:layout_width="14dp"
            android:layout_height="wrap_content" />

        <!-- Floating Plus Action Button -->
        <ImageButton
            android:id="@+id/fab_quick_add"
            android:layout_width="@dimen/floating_fab_size"
            android:layout_height="@dimen/floating_fab_size"
            android:background="@drawable/bg_fab_orange"
            android:contentDescription="@string/title_quick_add"
            android:src="@android:drawable/ic_input_add"
            android:scaleType="center"
            app:tint="@android:color/white" />

    </LinearLayout>

</FrameLayout>
