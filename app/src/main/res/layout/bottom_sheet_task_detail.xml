<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:background="@color/vega_surface_overlay">

        <!-- Handle indicator for bottom sheet -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:src="@drawable/bg_drag_handle" />

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Task Details"
            android:textAppearance="@style/TextAppearance.Vega.Title"
            android:textColor="@color/vega_on_background"
            android:layout_marginBottom="@dimen/spacing_lg" />

        <!-- Title Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_title"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_title"
            android:layout_marginBottom="@dimen/spacing_md"
            app:boxStrokeColor="@color/vega_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@color/vega_on_background" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Due Date Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_due_date"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_due_date"
            android:layout_marginBottom="@dimen/spacing_md"
            app:boxStrokeColor="@color/vega_primary"
            app:startIconDrawable="@android:drawable/ic_menu_agenda"
            app:startIconTint="@color/vega_on_surface"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_close_clear_cancel"
            app:endIconTint="@color/vega_on_surface_muted"
            app:endIconContentDescription="Clear Due Date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_due_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:textColor="@color/vega_on_background" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Priority Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_priority"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_priority"
            android:layout_marginBottom="@dimen/spacing_md"
            app:boxStrokeColor="@color/vega_primary">

            <AutoCompleteTextView
                android:id="@+id/actv_priority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/vega_on_background" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- State Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_state"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="State"
            android:layout_marginBottom="@dimen/spacing_md"
            app:boxStrokeColor="@color/vega_primary">

            <AutoCompleteTextView
                android:id="@+id/actv_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/vega_on_background" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Recurrence Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_recurrence"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_recurrence"
            android:layout_marginBottom="@dimen/spacing_md"
            app:boxStrokeColor="@color/vega_primary"
            app:startIconDrawable="@android:drawable/ic_menu_revert"
            app:startIconTint="@color/vega_recurring_accent"
            app:endIconMode="custom"
            app:endIconDrawable="@android:drawable/ic_menu_close_clear_cancel"
            app:endIconTint="@color/vega_on_surface_muted"
            app:endIconContentDescription="Clear Recurrence">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_recurrence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:textColor="@color/vega_on_background" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tags Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tags"
                android:textAppearance="@style/TextAppearance.Vega.Label"
                android:textColor="@color/vega_on_surface" />

            <TextView
                android:id="@+id/btn_manage_tags_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Manage Tags"
                android:textAppearance="@style/TextAppearance.Vega.Caption"
                android:textColor="@color/vega_primary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_detail_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:singleSelection="false" />

        <!-- Notes Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_notes"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_notes"
            android:layout_marginBottom="@dimen/spacing_2xl"
            app:boxStrokeColor="@color/vega_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:gravity="top"
                android:textColor="@color/vega_on_background" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_cancel"
                android:textColor="@color/vega_primary"
                android:layout_marginEnd="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_save"
                app:backgroundTint="@color/vega_primary"
                android:textColor="#121218" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
