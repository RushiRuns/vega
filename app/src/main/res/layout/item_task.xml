<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_task"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/vega_surface"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Foreground Content Layout -->
        <LinearLayout
            android:id="@+id/layout_foreground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <!-- Checkbox / Status Indicator -->
            <com.vega.ui.views.CircularCheckboxView
                android:id="@+id/circular_checkbox"
                android:layout_width="@dimen/checkbox_size"
                android:layout_height="@dimen/checkbox_size"
                android:layout_marginEnd="@dimen/spacing_md" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Task Title -->
                <TextView
                    android:id="@+id/tv_task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Vega.Title"
                    android:textColor="@color/vega_on_background" />

                <!-- Task Due Date -->
                <TextView
                    android:id="@+id/tv_task_due_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Vega.Label"
                    android:textColor="@color/vega_on_surface"
                    android:visibility="gone" />

                <!-- Recurrence Indicator Row -->
                <LinearLayout
                    android:id="@+id/layout_task_recurrence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        app:srcCompat="@drawable/ic_repeat"
                        app:tint="@color/vega_recurring_accent" />

                    <TextView
                        android:id="@+id/tv_task_recurrence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Vega.Caption"
                        android:textColor="@color/vega_recurring_accent" />
                </LinearLayout>

                <!-- Tags ChipGroup Row -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_task_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="4dp"
                    app:singleLine="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Priority Badge -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_priority"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone"
                app:chipMinHeight="@dimen/status_pill_height"
                app:chipCornerRadius="@dimen/pill_corner_radius"
                android:textAppearance="@style/TextAppearance.Vega.Label" />

        </LinearLayout>

        <!-- Swipe Actions Overlay Layout -->
        <LinearLayout
            android:id="@+id/layout_actions_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/vega_surface_overlay"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_postpone"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Postpone"
                android:textColor="@color/vega_on_background"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconTint="@color/vega_on_background"
                android:layout_marginEnd="@dimen/spacing_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_delete"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="@color/vega_priority_high"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/vega_priority_high" />

        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
